# Copy to .env.local and fill in. Never commit .env.local.

# Polymarket builder code (polymarket.com > Settings > Builder). Public by design: it is written into every order.
NEXT_PUBLIC_POLY_BUILDER_CODE=

# Polymarket builder API key (Builder > API keys > Create New). Server-only: never prefix with NEXT_PUBLIC_.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Hyperliquid builder address (public; needs >= 100 USDC in perps, standard mode). No key or secret exists.
NEXT_PUBLIC_HL_BUILDER=
# Builder fee in percent, charged only when users sell outcome shares (max 1). Defaults to 0.1.
NEXT_PUBLIC_HL_BUILDER_FEE_PERCENT=0.1
